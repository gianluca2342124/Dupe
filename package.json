{
  "name": "gemelu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gemelu — encuentra alternativas casi idénticas a los productos que te gustan, por mucho menos.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "preview:fixtures": "wrangler dev --config dist/server/wrangler.json --var FETCH_MODE:fixtures",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit -p . && astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "astro build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "cf-typegen": "wrangler types",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "smoke:search": "tsx scripts/smoke-search.ts",
    "smoke:aliexpress": "tsx scripts/aliexpress-smoke.ts",
    "sync:awin": "tsx scripts/sync-awin-feed.ts",
    "eval:matching": "tsx scripts/eval-matching.ts",
    "check:env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "htmlparser2": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  }
}
