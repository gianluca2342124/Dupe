---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import UrlForm from '../components/UrlForm';
import { BRAND } from '../config/brand';

export const prerender = true;

const faqs = [
  {
    q: '¿Es gratis?',
    a: `Sí. ${BRAND.name} no cobra a quien busca ni pide registro. Nos financiamos con comisiones de afiliación cuando alguien compra a través de algunos enlaces y, en el futuro, con publicidad claramente identificada.`,
  },
  {
    q: '¿Los productos son iguales que el original?',
    a: 'Te mostramos alternativas muy parecidas, no copias. Solo decimos “mismo producto” si comparten un código verificable (como el EAN). Una alternativa similar no tiene por qué tener el mismo fabricante ni la misma calidad.',
  },
  {
    q: '¿De qué tiendas puedo pegar enlaces?',
    a: 'De casi cualquier tienda online: IKEA, Zara Home, Kave Home, Sklum, Maisons du Monde, Westwing, Leroy Merlin, Amazon… Algunas tiendas bloquean la lectura automática; en ese caso usamos lo que dice el propio enlace o puedes describir el producto.',
  },
  {
    q: '¿Dónde están las alternativas?',
    a: 'Por ahora buscamos en AliExpress, con envío a España. Mostramos el precio que indica la tienda y, cuando lo conocemos, el envío.',
  },
  {
    q: '¿Cómo calculáis el ahorro?',
    a: 'Solo cuando los precios son comparables: misma moneda, mismo número de unidades y tamaños parecidos. Si conocemos el envío lo sumamos; si no, lo indicamos. No calculamos ahorro con precios “desde” ni con datos que no tenemos.',
  },
  {
    q: '¿Vendéis falsificaciones?',
    a: 'No vendemos nada, y además excluimos los anuncios que usan marcas, logotipos o nombres de diseños protegidos de otras empresas, y los que se anuncian como réplicas.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title="Cómo funciona" description={`Cómo ${BRAND.name} encuentra alternativas parecidas y más baratas a partir de un enlace de producto.`} jsonLd={jsonLd}>
  <section class="container-page max-w-4xl py-10 sm:py-16">
    <p class="eyebrow">Cómo funciona</p>
    <h1 class="display mt-3 text-5xl sm:text-7xl">Del enlace a sus gemelos.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2">
      {BRAND.name} lee la ficha del producto que te gusta, entiende qué es —tipo, forma, material, color, medidas— y busca alternativas parecidas que
      cuestan menos. Todo en segundos y sin registrarte.
    </p>
    <div class="mt-10"><HowItWorks /></div>

    <div class="mt-16 grid gap-10 sm:grid-cols-2">
      <div>
        <h2 class="display text-3xl">Qué analizamos</h2>
        <p class="mt-3 leading-relaxed text-ink-2">
          Leemos los datos estructurados que publica la tienda (nombre, precio, foto, material, color, medidas…) y los traducimos a un vocabulario de
          hogar y decoración en español e inglés. No inventamos datos: si algo no aparece, lo tratamos como desconocido.
        </p>
      </div>
      <div>
        <h2 class="display text-3xl">Cómo ordenamos</h2>
        <p class="mt-3 leading-relaxed text-ink-2">
          Cada alternativa tiene dos puntuaciones separadas: cuánto se parece al original y lo útil que es como compra (precio, envío, plazo,
          valoraciones). Las comisiones no influyen en el orden.
        </p>
      </div>
      <div>
        <h2 class="display text-3xl">Qué significa cada etiqueta</h2>
        <ul class="mt-3 space-y-2 leading-relaxed text-ink-2">
          <li><strong class="text-ink">Mismo producto:</strong> comparte un código verificable con el original.</li>
          <li><strong class="text-ink">Muy similar:</strong> coincide el tipo de producto, la forma y el material o el color.</li>
          <li><strong class="text-ink">Similar:</strong> mismo tipo de producto con varias características en común.</li>
          <li><strong class="text-ink">Baja confianza:</strong> parecido parcial; lo mostramos aparte y plegado.</li>
        </ul>
      </div>
      <div>
        <h2 class="display text-3xl">Qué no hacemos</h2>
        <p class="mt-3 leading-relaxed text-ink-2">
          No vendemos productos, no saltamos CAPTCHAs ni bloqueos de las tiendas, no mostramos réplicas que usan marcas ajenas y no te enseñamos
          porcentajes de parecido que no hayamos podido calibrar.
        </p>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="display text-4xl">Preguntas frecuentes</h2>
      <div class="mt-6 divide-y divide-line border-y border-line">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
                {f.q}
                <span class="text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-ink-2">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="card mt-16 p-6 text-center sm:p-10">
      <h2 class="display text-4xl">Pruébalo ahora</h2>
      <div class="mx-auto mt-6 max-w-xl"><UrlForm client:visible size="compact" /></div>
    </div>
  </section>
</BaseLayout>
