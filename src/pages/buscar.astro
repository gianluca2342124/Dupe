---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResultsApp from '../components/results/ResultsApp';
import { BRAND } from '../config/brand';
import { money } from '../lib/format';
import { getServices } from '../lib/server/services';
import { entryModeFrom, publicOrigin } from '../lib/server/request';
import { SearchError } from '../lib/search/service';
import { extractUrlFromText, toPrefixUrl } from '../lib/url/normalize';
import type { SearchErrorCode, SearchResultPayload } from '../types/search';

export const prerender = false;

const { search, config, provider } = getServices(env as unknown as Record<string, unknown>);
const params = Astro.url.searchParams;
const via = entryModeFrom(params.get('via'));
const site = publicOrigin(config.siteUrl, Astro.url);

// Inputs: ?url= (form, prefix capture, share target), ?q= (description), ?text= (share sheets).
const rawUrl = params.get('url') ?? (params.get('text') ? extractUrlFromText(params.get('text')!) : null) ?? '';
const q = params.get('q')?.trim() ?? '';

let initialResult: SearchResultPayload | null = null;
let initialError: { code: SearchErrorCode; message: string } | null = null;
let storeName: string | null = null;
let shareUrl = site;
let title = 'Buscar alternativas';

if (rawUrl) {
  try {
    const n = search.normalize(rawUrl);
    storeName = n.store.name;
    shareUrl = toPrefixUrl(site, n.canonical);
    initialResult = await search.cached(rawUrl);
  } catch (err) {
    if (err instanceof SearchError) initialError = { code: err.code, message: err.message };
    else throw err;
  }
} else if (q) {
  shareUrl = `${site}/buscar?q=${encodeURIComponent(q)}`;
}

if (initialResult?.source.title) {
  const cheapest = initialResult.summary.cheapestTotal;
  title = `Alternativas a ${initialResult.source.title}${cheapest && !initialResult.provider.isDemo ? ` desde ${money(cheapest)}` : ''}`;
}
const description = initialResult
  ? `${initialResult.items.length} alternativas parecidas encontradas con ${BRAND.name}. ${BRAND.tagline}`
  : BRAND.description;
const query = rawUrl ? ({ kind: 'url', url: rawUrl } as const) : q ? ({ kind: 'text', q } as const) : null;
---

<BaseLayout title={title} description={description} noindex canonical={shareUrl} headerVariant="compact">
  {
    query ? (
      <ResultsApp
        client:load
        query={query}
        via={via}
        initialResult={initialResult}
        initialError={initialError}
        initialStoreName={storeName}
        shareUrl={shareUrl}
        domain={new URL(site).host}
        providerLabel={provider.capabilities.isDemo ? 'el catálogo de demostración' : provider.label}
        ads={{ enabled: config.ads.enabled, client: config.ads.clientId, slot: config.ads.slotResults }}
      />
    ) : (
      <div class="container-page max-w-2xl py-16 text-center">
        <h1 class="display text-4xl sm:text-5xl">Pega el enlace de un producto</h1>
        <p class="mt-3 text-ink-2">O añade {new URL(site).host}/ delante de cualquier enlace en la barra del navegador.</p>
        <div class="mt-8">
          <form action="/buscar" method="get" class="flex gap-2">
            <input name="url" type="url" required placeholder="https://…" class="h-12 min-w-0 flex-1 rounded-full border border-line-2 bg-card px-5 outline-none" />
            <button class="btn btn-primary">Buscar</button>
          </form>
        </div>
      </div>
    )
  }
</BaseLayout>
