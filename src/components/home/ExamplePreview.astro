---
import { DEFAULT_MATCHING_CONFIG } from '../../config/matching';
import { formatMoney } from '../../lib/extraction/price';
import { analyzeSource, runMatching } from '../../lib/matching/pipeline';
import { DemoCatalogProvider } from '../../lib/providers/demo/provider';
import { exampleSource } from '../../lib/search/examples';

/**
 * Home preview: the real matching engine run at build time against the DEMO
 * catalogue for a fictional example product. Labelled as a demo.
 */
const source = exampleSource('lampara-seta')!;
const output = await runMatching({
  source,
  analysis: analyzeSource(source),
  provider: new DemoCatalogProvider(() => new Date('2026-10-01T09:00:00Z')),
  config: DEFAULT_MATCHING_CONFIG,
});
const top = output.results.slice(0, 3);
const best = top.map((c) => c.savings).filter(Boolean).sort((a, b) => b!.percent - a!.percent)[0];
---

<a href="/ejemplo/lampara-seta" class="group card block overflow-hidden transition-shadow hover:shadow-lift" data-testid="example-preview">
  <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3 sm:px-5">
    <span class="chip bg-demo-soft text-demo">DEMO · datos ficticios</span>
    <span class="text-xs text-ink-3">Así se ve un resultado</span>
  </div>
  <div class="grid gap-4 p-4 sm:grid-cols-[0.9fr_1.6fr] sm:p-5">
    <div class="flex items-center gap-3 sm:flex-col sm:items-start">
      <img src={source.image!} alt="" width="400" height="400" class="size-24 rounded-2xl bg-sand object-cover sm:size-auto sm:w-full" loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">Original · Tienda de ejemplo</p>
        <p class="mt-1 text-sm font-semibold leading-snug">{source.title}</p>
        <p class="mt-1 text-lg font-semibold tabular-nums">{formatMoney(source.price!)}</p>
      </div>
    </div>
    <div>
      <p class="text-sm text-ink-2">
        {top.length} alternativas muy parecidas{best ? <> · ahorro de hasta <strong class="text-save">{best.percent} %</strong></> : null}
      </p>
      <ul class="mt-3 grid grid-cols-3 gap-2.5">
        {
          top.map((c) => (
            <li class="min-w-0">
              <img src={c.product.image!} alt="" width="400" height="400" class="aspect-square w-full rounded-xl bg-sand object-cover" loading="lazy" decoding="async" />
              <p class="mt-1.5 text-sm font-semibold tabular-nums">{formatMoney(c.product.price!)}</p>
              {c.savings && <p class="text-xs font-semibold text-save">−{c.savings.percent} %</p>}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-terracotta">
        Ver el ejemplo completo
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </p>
    </div>
  </div>
</a>
