# ─────────────────────────────────────────────────────────────────────────────
# Gemelu — environment variables
#
# Local development: copy to `.dev.vars` (read by wrangler/astro dev) and fill in.
# Production: non-secret values live in wrangler.jsonc → "vars"; secrets are set
# with `npx wrangler secret put NAME` (never committed, never sent to browsers).
# ─────────────────────────────────────────────────────────────────────────────

# ── General ─────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://gemelu.com          # canonical origin (also used at build time)
PRODUCT_PROVIDER=demo                       # demo | aliexpress | awin
FETCH_MODE=live                             # live | fixtures (fixtures = tests only)
LOG_LEVEL=info                              # debug | info | warn | error
DAILY_SEARCH_BUDGET=3000                    # max uncached searches per day (cost control)
RATE_LIMIT_MODE=edge                        # edge | memory | off (off = local tests only)

# ── Source-page reading ─────────────────────────────────────────────────────
SOURCE_HOST_POLICY=public                   # public | allowlist
SOURCE_HOST_ALLOWLIST=                      # e.g. ikea.com,sklum.com (allowlist mode)
SOURCE_HOST_DENYLIST=                       # domains never fetched
ROBOTS_POLICY=respect                       # respect | ignore
DNS_GUARD=doh                               # doh | off  (DNS-rebinding protection)
HEADLESS_HOSTS=                             # domains allowed for headless rendering (optional)
CF_ACCOUNT_ID=                              # [secret] Cloudflare Browser Rendering (optional)
CF_BROWSER_RENDERING_TOKEN=                 # [secret]

# ── Links ───────────────────────────────────────────────────────────────────
LINK_SIGNING_SECRET=                        # [secret] ≥32 random chars: `openssl rand -hex 32`
GO_ALLOWED_HOSTS=                           # extra redirect hosts besides AliExpress/Awin

# ── AliExpress Open Platform (affiliate API) ────────────────────────────────
ALIEXPRESS_APP_KEY=                         # [secret]
ALIEXPRESS_APP_SECRET=                      # [secret]
ALIEXPRESS_TRACKING_ID=                     # [secret] tracking id from the AliExpress Portals account
ALIEXPRESS_LANGUAGE=ES
ALIEXPRESS_CURRENCY=EUR
ALIEXPRESS_SHIP_TO=ES
ALIEXPRESS_USE_PRICE_FILTER=false           # pass max_sale_price (documented in cents)
ALIEXPRESS_SHIPPING_LOOKUPS=6               # product.shipping.get calls per search (0 = off)

# ── Awin ────────────────────────────────────────────────────────────────────
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=                             # [secret] OAuth2 token from Awin → API credentials
AWIN_FEED_URL=                              # [secret] Create-a-Feed / Enhanced feed download URL
AWIN_ALIEXPRESS_ADVERTISER_ID=              # Awin advertiser id of the AliExpress programme
AWIN_DEEPLINK_ENABLED=false                 # build cread.php deep links for items without aw_deep_link

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                  # [secret] server only — bypasses RLS

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_USER=
ADMIN_PASSWORD=                             # [secret] long random password; also put Cloudflare Access in front

# ── Optional AI vision (only for products the deterministic analysis can't classify) ──
VISION_PROVIDER=none                        # none | anthropic
ANTHROPIC_API_KEY=                          # [secret]
VISION_MODEL=claude-opus-5-5                # e.g. claude-haiku-5-5 for lower cost
VISION_DAILY_LIMIT=200

# ── Ads & analytics (off by default) ────────────────────────────────────────
ADS_ENABLED=false
ADSENSE_CLIENT_ID=                          # ca-pub-…
ADSENSE_SLOT_RESULTS=
SHOW_SIMILARITY_PERCENT=false               # only after calibration (scripts/eval-matching.ts)
PUBLIC_CF_WEB_ANALYTICS_TOKEN=              # cookieless Cloudflare Web Analytics (build time)
